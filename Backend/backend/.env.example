# OmniFace Backend — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file.

# ── Environment ────────────────────────────────────────────────────────────────
# "production" disables Swagger UI (/docs, /redoc) and tightens defaults.
# "development" enables Swagger UI and more permissive settings for local use.
ENVIRONMENT=production

# Set to True ONLY for local development — NEVER in production.
DEBUG=False

# ── Firebase ───────────────────────────────────────────────────────────────────
# Path to your Firebase Admin SDK service account JSON key file OR the inline JSON string itself.
# On Render/Railway/PaaS: You can paste the entire JSON string directly as this environment variable.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Keep this file/value SECRET — never commit it to git.
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/your/firebase-adminsdk.json

# ── Cloudinary ─────────────────────────────────────────────────────────────────
# Find these in: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Auth ───────────────────────────────────────────────────────────────────────
# MUST be True in production — all endpoints require a valid Firebase ID token.
# Set to False ONLY during local development when the frontend has no real auth.
REQUIRE_AUTH=True

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list (JSON array) of allowed origins.
# Replace localhost URLs with your production frontend URL before deploying.
# Example: CORS_ORIGINS=["https://app.yourcompany.com"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Upload limits ──────────────────────────────────────────────────────────────
# Maximum upload size in megabytes (1–1000). Keep ≤100 MB in production.
MAX_FILE_SIZE_MB=100

# Maximum sanitized filename length (characters).
MAX_FILENAME_LENGTH=200

# ── Job timeout ────────────────────────────────────────────────────────────────
# Maximum seconds a background video analysis job may run before being aborted.
JOB_TIMEOUT_SECONDS=300

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Format: "N/period" — e.g. "10/minute", "100/hour"
RATE_LIMIT_ANALYZE=10/minute

# ── Video processing ───────────────────────────────────────────────────────────
# Number of evenly-spaced frames to sample from each video for analysis.
VIDEO_FRAME_SAMPLE_COUNT=8

# ── ML Detection Engine / Stub Mode ───────────────────────────────────────────
# True:  Runs synthetic development stubs for pipeline testing with explicit disclosure warnings.
# False: Production mode. Real trained model checkpoints MUST be loaded. If models
#        are missing, endpoints fail-closed rather than presenting random output as real detection.
# WARNING: Do NOT launch publicly with ML_STUB_MODE=True without trained models.
ML_STUB_MODE=True
