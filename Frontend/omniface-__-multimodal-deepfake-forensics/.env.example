# OmniFace Frontend — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit your real .env.local file — it is already in .gitignore.

# ── Backend API ────────────────────────────────────────────────────────────────
# URL of the OmniFace FastAPI backend (no trailing slash).
# Development: http://127.0.0.1:8000
# Production:  https://api.yourcompany.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── App metadata ───────────────────────────────────────────────────────────────
# Public-facing application name (used in meta tags, titles, etc.)
NEXT_PUBLIC_APP_NAME=OmniFace Deepfake Forensics

# ── Upload limits (client-side pre-validation) ─────────────────────────────────
# Must match or be smaller than the backend MAX_FILE_SIZE_MB setting.
# The backend enforces the real limit; this value is for UX pre-validation only.
NEXT_PUBLIC_MAX_UPLOAD_MB=100

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id